{
  "name": "dsh-plugin-mobile-ux",
  "version": "1.4.2",
  "description": "DeepSeek Harness 手机端体验插件：侧栏抽屉、阅读排版、输入区适配、设置页全屏。纯前端注入，不修改宿主源码。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "cordis.patch.yml",
    "docs",
    "host-patches"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "responsive",
    "ios",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wond03/dsh-plugin-mobile-ux.git"
  },
  "homepage": "https://github.com/wond03/dsh-plugin-mobile-ux#readme",
  "bugs": {
    "url": "https://github.com/wond03/dsh-plugin-mobile-ux/issues"
  },
  "author": "wond03"
}
